# Copy to .env (git-ignored) to override defaults. Nothing here is required.
# Paths are relative to the project root.
RAW_DATA_PATH=data/raw/emails.csv
PROCESSED_DATA_PATH=data/processed/emails_cleaned.csv
MODEL_PATH=models/spam_classifier_pipeline.joblib
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Set to 1 to REFUSE to load a model whose SHA-256 differs from models/manifest.json
STRICT_MODEL_INTEGRITY=0

# OPTIONAL external URL reputation (leave empty to stay fully offline).
# Never commit real keys. They are never logged or displayed by the app.
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
