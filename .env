# =================================================================
# .env
# -----------------------------------------------------------------
# Environment configuration for the Spam Classification project.
# Loaded automatically by src/config.py using python-dotenv.
#
# Why use a .env file instead of hard-coding paths in every script?
#   - Change a path in ONE place instead of editing train.py,
#     predict.py, and app.py separately.
#   - Different machines/deployments can use different paths without
#     touching code (e.g. a different dataset location on your PC
#     vs. on Streamlit Cloud).
#   - Keeps configuration separate from logic (standard practice).
#
# NOTE: this file contains no secrets/passwords, so it's safe to
# commit for this project. If you ever add API keys or credentials,
# move those to a separate .env that is listed in .gitignore instead.
# =================================================================

# --- Data paths ---
RAW_DATA_PATH=data/raw/emails.csv
PROCESSED_DATA_PATH=data/processed/emails_cleaned.csv

# --- Model path ---
MODEL_PATH=models/spam_classifier_pipeline.joblib

# --- Logging ---
# LOG_LEVEL options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
